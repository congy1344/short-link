{
  "name": "shortlink",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "node -e \"const fs=require('fs'),cp=require('child_process'),npm=process.platform==='win32'?'npm.cmd':'npm'; for (const w of ['backend','frontend']) if (fs.existsSync(w+'/package.json')) cp.execFileSync(npm,['run','lint','--workspace',w,'--if-present'],{stdio:'inherit'});\"",
    "typecheck": "node -e \"const fs=require('fs'),cp=require('child_process'),npm=process.platform==='win32'?'npm.cmd':'npm'; for (const w of ['backend','frontend']) if (fs.existsSync(w+'/package.json')) cp.execFileSync(npm,['run','typecheck','--workspace',w,'--if-present'],{stdio:'inherit'});\"",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process'),npm=process.platform==='win32'?'npm.cmd':'npm'; for (const w of ['backend','frontend']) if (fs.existsSync(w+'/package.json')) cp.execFileSync(npm,['run','test','--workspace',w,'--if-present'],{stdio:'inherit'});\"",
    "build": "node -e \"const fs=require('fs'),cp=require('child_process'),npm=process.platform==='win32'?'npm.cmd':'npm'; for (const w of ['backend','frontend']) if (fs.existsSync(w+'/package.json')) cp.execFileSync(npm,['run','build','--workspace',w,'--if-present'],{stdio:'inherit'});\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
