{
  "name": "@shortlink/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:validate": "node scripts/prisma.mjs validate --schema prisma/schema.prisma",
    "db:generate": "node scripts/prisma.mjs generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/prisma.mjs migrate dev --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node -e \"import('./dist/health.js').then((m) => { if (m.health().status !== 'ok') process.exit(1); })\"",
    "build": "npm run db:generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "fastify": "5.9.0",
    "redis": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "prisma": "6.19.2",
    "typescript": "6.0.3"
  }
}
